rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "kristianai2011@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidFeedback(data) {
      return data.rating is int && data.rating >= 1 && data.rating <= 10 &&
             (data.message == null || (data.message is string && data.message.size() <= 1000)) &&
             data.timestamp is string;
    }

    function isValidProgress(data) {
      return data.unlockedSectorCount is int && data.unlockedSectorCount >= 1 &&
             data.lastUpdated is string &&
             (data.highestEndlessWaves == null || data.highestEndlessWaves is map) &&
             (data.totalWavesSurvived == null || data.totalWavesSurvived is int) &&
             (data.totalSessionsSaved == null || data.totalSessionsSaved is int) &&
             (data.commanderExp == null || data.commanderExp is int) &&
             (data.medals == null || data.medals is list) &&
             (data.unlockedTurrets == null || data.unlockedTurrets is list) &&
             (data.unlockedUpgrades == null || data.unlockedUpgrades is list) &&
             (data.encounteredEnemies == null || data.encounteredEnemies is list);
    }

    function isValidEndlessSession(data) {
      return data.userId is string &&
             data.userName is string &&
             (data.commanderLevel == null || data.commanderLevel is int) &&
             data.mapId is string &&
             data.difficulty is string &&
             data.wave is int &&
             data.gold is int &&
             data.lives is int &&
             data.turrets is list &&
             data.lastUpdated is string;
    }

    function isValidCommunityMap(data) {
      return data.userId is string &&
             data.userName is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             (data.description == null || (data.description is string && data.description.size() <= 500)) &&
             data.cols is int && data.cols >= 5 && data.cols <= 25 &&
             data.rows is int && data.rows >= 5 && data.rows <= 25 &&
             data.grid is list && data.grid.size() == data.cols * data.rows &&
             data.paths is list && data.paths.size() > 0 &&
             data.createdAt is string;
    }

    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(request.resource.data);
      allow read: if isAdmin();
    }

    match /community_maps/{mapId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidCommunityMap(request.resource.data);
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid &&
                      isValidCommunityMap(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId}/progress/{docId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidProgress(request.resource.data);
    }

    match /users/{userId}/endless_sessions/{sessionId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidEndlessSession(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/sandbox_sessions/{sessionId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidEndlessSession(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
