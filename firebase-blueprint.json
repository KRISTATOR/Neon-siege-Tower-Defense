{
  "entities": {
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback and ratings for the game.",
      "type": "object",
      "properties": {
        "rating": {
          "type": "integer",
          "description": "Rating from 1 to 10."
        },
        "message": {
          "type": "string",
          "description": "Feedback message from the user."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the feedback was submitted."
        }
      },
      "required": ["rating", "timestamp"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Saves user game progress.",
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "description": "User's chosen display name."
        },
        "unlockedSectorCount": {
          "type": "integer",
          "description": "Number of sectors unlocked in campaign."
        },
        "highestEndlessWaves": {
          "type": "object",
          "description": "Highest wave reached in endless mode per map."
        },
        "totalWavesSurvived": {
          "type": "integer",
          "description": "Total waves survived across all sessions."
        },
        "totalSessionsSaved": {
          "type": "integer",
          "description": "Total times a session was saved to the library."
        },
        "commanderExp": {
          "type": "integer",
          "description": "Experience points for commander leveling."
        },
        "medals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Earned medals and achievements."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Last time progress was synced."
        }
      },
      "required": ["unlockedSectorCount", "lastUpdated"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "A user's entry in the global leaderboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "nickname": { "type": "string" },
        "highestWave": { "type": "integer" },
        "totalEnemiesKilled": { "type": "integer" },
        "totalGoldEarned": { "type": "integer" },
        "commanderLevel": { "type": "integer" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "nickname", "highestWave", "totalEnemiesKilled", "totalGoldEarned", "commanderLevel", "lastUpdated"]
    },
    "EndlessSession": {
      "title": "EndlessSession",
      "description": "An active endless mode game session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "commanderLevel": { "type": "integer" },
        "mapId": { "type": "string" },
        "difficulty": { "type": "string" },
        "wave": { "type": "integer" },
        "gold": { "type": "integer" },
        "lives": { "type": "integer" },
        "turrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "gridX": { "type": "integer" },
              "gridY": { "type": "integer" },
              "level": { "type": "integer" }
            }
          }
        },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "mapId", "difficulty", "wave", "gold", "lives", "turrets", "lastUpdated"]
    },
    "CommunityMap": {
      "title": "CommunityMap",
      "description": "A player-created map shared with the community.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "cols": { "type": "integer" },
        "rows": { "type": "integer" },
        "grid": { 
          "type": "array",
          "items": { "type": "integer" },
          "description": "Flat array representing the grid (0: empty, 1: path, 2: spawn, 3: goal)"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": { "type": "integer" },
                "y": { "type": "integer" }
              }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "likes": { "type": "integer" },
        "plays": { "type": "integer" }
      },
      "required": ["userId", "userName", "name", "cols", "rows", "grid", "paths", "createdAt"]
    }
  },
  "firestore": {
    "feedback": {
      "schema": "Feedback",
      "description": "Collection of user feedback and ratings."
    },
    "community_maps": {
      "schema": "CommunityMap",
      "description": "Public collection of player-created maps."
    },
    "leaderboard": {
      "schema": "LeaderboardEntry",
      "description": "Global leaderboard for all players."
    },
    "users/{userId}/progress": {
      "schema": "UserProgress",
      "description": "User-specific game progress."
    },
    "users/{userId}/endless_sessions/{sessionId}": {
      "schema": "EndlessSession",
      "description": "User-specific active endless game sessions."
    },
    "users/{userId}/sandbox_sessions/{sessionId}": {
      "schema": "EndlessSession",
      "description": "User-specific active sandbox game sessions."
    }
  }
}
